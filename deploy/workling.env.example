WORKLING_WORKSPACE=/var/lib/workling
# rootless Docker 的 socket；把 1000 换成 `id -u workling` 的结果。
DOCKER_HOST=unix:///run/user/1000/docker.sock
# 执行器在管理页设置；首次启动会从 WORKLING_SANDBOX、WORKLING_TASK_* 环境变量导入一次。
# 生产部署只允许 Docker 执行器：worker 在独立容器与独立网络中运行，看不到主体与其他任务。
WORKLING_REQUIRE_DOCKER=true
WORKLING_SANDBOX=docker
