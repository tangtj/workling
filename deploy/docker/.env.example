# 镜像（GHCR 地址，小写）与版本；update.sh 会改写 WORKLING_VERSION
WORKLING_IMAGE=ghcr.io/owner/repo
WORKLING_VERSION=latest
# 宿主机 docker 组的 gid（getent group docker | cut -d: -f3），主体容器用它访问 docker.sock
DOCKER_GID=
# 可选：worker 镜像，默认 ${WORKLING_IMAGE}-worker:${WORKLING_VERSION}，与主体同版本发布
# WORKLING_WORKER_IMAGE=
# 机器名，写入评论与运行记录
WORKLING_WORKER=workling-docker
# 可选：数据目录挂载到宿主机路径（如 /srv/workling），默认使用命名卷 workling-data
# WORKLING_DATA_DIR=
# 其余配置（LLM、执行器、并发等）在管理页「设置」中修改

# 在线更新源码仓库（owner/repo）；不设置则无法检查更新
WORKLING_UPDATE_REPO=
# 私有仓库：fine-grained token，仅授权该仓库 Contents 只读；公开仓库可留空
WORKLING_UPDATE_TOKEN=
# 可选：GitHub API、源码下载与依赖安装代理
WORKLING_UPDATE_PROXY=
