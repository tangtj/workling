[Unit]
Description=workling watch
# rootless Docker 是服务用户的 user 级服务，这里无法声明依赖；Docker 不可用时 workling 暂停拉起并在管理页提示。
After=network-online.target

[Service]
User=workling
WorkingDirectory=/opt/workling
EnvironmentFile=/etc/workling/workling.env
ExecStart=/usr/local/bin/bun src/cli.ts serve
Restart=always
# 停止 watch 时不结束它拉起的任务（none 模式下的 task 进程）
KillMode=process

[Install]
WantedBy=multi-user.target
